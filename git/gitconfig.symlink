# Local/private config goes in the include
[include]
        path = ~/.gitconfig.local
[hub]
        protocol = ssh
[alias]
        s = status -sb
        co = checkout
        count   = !git shortlog -sn
        branches = branch -a
        tags = tag
        stashes = stash list
        unstage = reset -q HEAD --
        discard = checkout --
        uncommit = reset --mixed HEAD~
        ammend = commit --amend
        nevermind = !git reset --hard HEAD && git clean -d -f
        cclean = clean -ffdx -e .vscode -e venv -e .env
        ff = merge --ff-only
[color]
        diff = auto
        status = auto
        branch = auto
        ui = true
[core]
        excludesfile = ~/.gitignore
        editor = nvim
        autocrlf = input
        pager = delta # git-delta pkg on fedora
[interactive]
        diffFilter = delta --color-only
[delta]
        navigate = true
        line-numbers = true
[apply]
        whitespace = nowarn
[mergetool]
        keepBackup = false
[difftool]
        prompt = false
[help]
        autocorrect = 1
[push]
        # First push of a new branch creates and tracks origin/<branch>
        autoSetupRemote = true
[filter "lfs"]
        clean = git-lfs clean -- %f
        smudge = git-lfs smudge -- %f
        process = git-lfs filter-process
        required = true
[diff]
        tool = bc
        colorMoved = default
[difftool "bc"]
        trustExitCode = true
[merge]
        tool = bc
        conflictStyle = diff3
[mergetool "bc"]
        trustExitCode = true
[pull]
        ff = only
[init]
        defaultBranch = main

[credential]
        helper = cache --timeout 21600
        helper = oauth
